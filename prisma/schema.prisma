// Orbit — Schéma de base de données (Phase 1)
// SQLite via Prisma (adaptation environnement sandbox — PostgreSQL/Supabase en production)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String             @id @default(cuid())
  email            String             @unique
  passwordHash     String
  name             String?
  timezone         String             @default("UTC") // Fuseau d'affichage préféré (IANA)
  preferences      Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  events           Event[]
  tasks            Task[]
  tags             Tag[]
  emailLogs        EmailLog[]
  emailAccounts    EmailAccount[]
  pushSubscriptions PushSubscription[]
  notifications    Notification[]
  notificationPreference NotificationPreference?
  apiKeys          ApiKey[]
  webhooks         Webhook[]
}

// ── API publique (features avancées) ─────────────────────────────────────────
// Clés d'API pour les intégrations tierces (REST /api/v1/*). La clé brute
// `orbit_<32 hex>` n'est JAMAIS stockée : seul son SHA-256 l'est (comparaison
// par hash — vol de base = clés inutilisables). Le préfixe `orbit_prefix`
// (8 car.) permet de reconnaître la clé dans l'UI SANS la dévoiler.
model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /** Libellé lisible (« Zapier », « Script perso »…). */
  name        String
  /** SHA-256 hex de la clé brute — LA clé complète n'existe qu'une fois, à la création. */
  keyHash     String    @unique
  /** Préfixe non sensible affiché dans l'UI (ex. « orbit_a1b2c3d4 »). */
  keyPrefix   String
  /** Date de dernière utilisation (null = jamais servie). */
  lastUsedAt  DateTime?
  isActive    Boolean   @default(true)

  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@index([userId])
}

// ── Webhooks sortants ────────────────────────────────────────────────────────
// Livraison POST signée HMAC-SHA256 (en-tête X-Orbit-Signature: sha256=<hex>).
// Le secret de signature est généré côté serveur et stocké CHIFFRÉ AES-256-GCM
// (lib/secret-box, clé dérivée de AUTH_SECRET) : déchiffré uniquement au
// moment de signer une livraison. SQLite : pas d'enum/arrays → événements en Json.
model Webhook {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /** URL de destination (https exigé, validée Zod). */
  url         String
  /** Description optionnelle. */
  description String?
  /** Liste d'événements déclencheurs (JSON) : task.created|updated|deleted, event.created|updated|deleted, test. */
  events      Json
  /** Secret de signature AES-256-GCM (format v1:iv:tag:ct) — jamais en clair. */
  secretEnc   String
  isActive    Boolean   @default(true)

  /** Dernier résultat (télémétrie UI). */
  lastStatus  String? // "success" | "failed"
  lastDeliveryAt DateTime?
  lastError   String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  logs        WebhookLog[]

  @@index([userId, isActive])
}

// Journal des livraisons (audit + diagnostic UI) — purgé au-delà de 100 entrées
// par webhook (garde de taille, SQLite).
model WebhookLog {
  id          String    @id @default(cuid())
  webhookId   String
  webhook     Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  /** Nom de l'événement livré (ex. « task.created ») ou « test ». */
  event       String
  /** "success" | "failed". */
  status      String
  /** Code HTTP de réponse du destinataire (null = réseau/timeout). */
  statusCode  Int?
  /** Message d'erreur (échec réseau, signature…). */
  error       String?
  /** Durée totale de la livraison en ms. */
  durationMs  Int?
  createdAt   DateTime  @default(now())

  @@index([webhookId, createdAt])
}

// ── Comptes email IMAP réels ───────────────────────────────────────────────────
// Le mot de passe IMAP n'est JAMAIS stocké en clair : chiffrement AES-256-GCM
// (lib/secret-box, clé dérivée de AUTH_SECRET) — cf. docs/email-imap-guide.md.
model EmailAccount {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /** Libellé d'affichage optionnel (« Perso », « Travail »…) */
  label     String?
  /** Adresse email du compte (unique par utilisateur) */
  address   String

  // Connexion IMAP (lecture seule sur la boîte — jamais de modification serveur)
  imapHost  String
  imapPort  Int     @default(993)
  /** true = TLS implicite (993) · false = STARTTLS (143) */
  imapSecure Boolean @default(true)
  /** Identifiant IMAP (souvent = adresse email) */
  username  String
  /** Mot de passe chiffré AES-256-GCM (format v1:iv:tag:ct) — JAMAIS en clair */
  passwordEnc String
  /** TLS auto-signé accepté (QA/serveurs internes — déconseillé en production) */
  allowSelfSigned Boolean @default(false)

  // Envoi SMTP (optionnel — null = envoi non configuré pour ce compte).
  // Mêmes garanties de chiffrement que l'IMAP : mot de passe AES-256-GCM.
  smtpHost String?
  smtpPort Int? @default(587)
  /** true = TLS implicite (465) · false = STARTTLS (587) */
  smtpSecure Boolean @default(true)
  smtpUsername String? // null = identifiant IMAP réutilisé
  /** Mot de passe SMTP chiffré AES-256-GCM — null = mot de passe IMAP réutilisé */
  smtpPasswordEnc String?

  // Réglages de synchronisation
  /** Intervalle de synchronisation automatique (minutes, min 5) */
  syncIntervalMin Int @default(15)
  /** Fenêtre de récupération initiale (jours) */
  fetchDays  Int @default(30)
  /** Nombre max de messages par synchronisation */
  maxMessages Int @default(100)

  /** Compte actif (false = suspendu, plus de sync) */
  isActive  Boolean @default(true)

  // Télémétrie de synchronisation (jamais de contenu)
  lastSyncAt     DateTime?
  /** "ok" | "error" */
  lastSyncStatus String?
  lastSyncError  String?
  lastSyncCount  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emails EmailLog[]

  @@unique([userId, address])
  @@index([userId, isActive])
}

model Event {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  title               String
  description         String?
  location            String?

  // Règle d'or : instants TOUJOURS stockés en UTC ; la timezone IANA de
  // référence de l'événement est stockée à part pour l'affichage/récurrence.
  startTime           DateTime
  endTime             DateTime
  allDay              Boolean   @default(false)
  timezone            String    @default("UTC") // IANA, ex. "Europe/Paris"

  // Récurrence : { frequency: "daily"|"weekly"|"monthly", interval, until?, count?, byDays?, nth? }
  // Les occurrences sont « expansées » à la volée — jamais persistées en base.
  recurrence          Json?
  // Débuts (ISO UTC) des occurrences annulées/éditées séparément (exceptions de série)
  recurrenceExceptions Json?

  attendees           Json?     // [{ email, name?, status: "pending"|"accepted"|"declined" }]
  reminders           Json?     // [{ minutes, type: "push"|"email" }] — défaut : 15 min push

  color               String?   // Hex (#RRGGBB) — null = couleur automatique par source

  source              String    @default("manual") // manual | email_extract | ai | import
  externalId          String?   // UID iCal (import idempotent) / ID service externe

  reminderSentAt      DateTime? // Legacy : rappel par défaut déjà envoyé (événement simple)
  reminderLog         Json?     // Clés de rappels déjà envoyés (occurrences + multi-rappels)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([userId, startTime])
  @@index([userId, endTime])
  @@index([userId, externalId])

  // Tâches liées à cet événement (lien optionnel tâche ↔ calendrier)
  tasks            Task[]
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?

  // Statut kanban : "todo" | "doing" | "done" | "archived"
  // (archivé = soft delete, masqué par défaut dans l'UI ;
  //  correspond à TODO / IN_PROGRESS / DONE / ARCHIVED de la spec)
  status      String    @default("todo")
  // Priorité : "LOW" | "MEDIUM" | "HIGH" | "URGENT"
  priority    String    @default("MEDIUM")

  // Ordre dans la colonne Kanban — entiers ESPACÉS (1000, 2000, 3000…)
  // pour éviter les recalculs fréquents ; renormalisés côté serveur au move.
  position    Int       @default(0)

  dueDate     DateTime?
  // Horodatage de passage à "done" (statistiques de complétion)
  completedAt DateTime?

  // Étiquettes (many-to-many, partagées entre les tâches de l'utilisateur)
  tags        Tag[]     @relation("TaskTags")

  // Sous-tâches (supprimées en cascade avec la tâche)
  subtasks    SubTask[]

  // Suggestion de priorité par l'IA (Phase 4 — placeholder, non peuplé)
  aiSuggestedPriority String? // "LOW" | "MEDIUM" | "HIGH" | "URGENT"
  aiConfidence        Float?   // score de confiance 0..1

  // Lien optionnel vers un événement du calendrier
  eventId     String?
  event       Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)

  // Horodatage du rappel « H-1 » (reminder-service) — nullable = pas encore notifié
  reminderSentAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([userId, priority])
}

model SubTask {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  title     String
  completed Boolean  @default(false)
  // Ordre dans la liste des sous-tâches (entiers espacés, même convention que Task)
  position  Int      @default(0)

  createdAt DateTime @default(now())

  @@index([taskId])
}

model Tag {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name   String
  color  String @default("#00D4FF") // hex #RRGGBB

  tasks  Task[] @relation("TaskTags")

  // Un même nom de tag une seule fois par utilisateur (upsert côté API)
  @@unique([userId, name])
}

model EmailLog {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /** Message-ID MIME — dédoublonné PAR UTILISATEUR (multi-comptes possibles) */
  messageId      String
  fromAddress    String
  fromName       String?
  /** Destinataires ("To") — tableau d'adresses en JSON (SQLite : pas de String[]) */
  toAddresses    Json?
  subject        String
  /** Extrait du corps (≤ 200 car.) pour la liste — null = calcul à l'affichage */
  snippet        String?
  bodyText       String
  /** Version HTML nettoyée (sanitize-html : scripts/styles/onclick retirés) —
   *  rendue dans une iframe sandbox. Null = affichage texte. */
  bodyHtml       String?
  receivedAt     DateTime
  /** Horodatage d'envoi (emails partis d'Orbit — dossier SENT) */
  sentAt         DateTime?
  isRead         Boolean   @default(false)
  /** Étoile / suivi (drapeau \Flagged IMAP à la sync) */
  isStarred      Boolean   @default(false)
  isProcessed    Boolean   @default(false)
  /** Dossier virtuel : INBOX | SENT | ARCHIVE | TRASH */
  folder         String    @default("INBOX")
  /** Message-ID parent (In-Reply-To/References) — regroupement de conversation */
  threadId       String?
  /** Pièces jointes présentes (métadonnées dans EmailAttachment) */
  hasAttachments Boolean   @default(false)
  /** UID IMAP du message (mise à jour des drapeaux côté serveur) */
  uid            Int?
  suggestedEvent Json? // Résultat d'extraction IA en attente de confirmation
  createdAt      DateTime  @default(now())
  /** @default(now()) requis pour la migration des lignes existantes (SQLite) */
  updatedAt      DateTime  @default(now()) @updatedAt

  /** Compte IMAP d'origine (null = démo/emails synthétiques) — conservé
   *  à la suppression du compte (SetNull : l'email reste consultable) */
  accountId      String?
  account        EmailAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  attachments    EmailAttachment[]

  @@unique([userId, messageId])
  @@index([userId, receivedAt])
  @@index([userId, folder])
  @@index([userId, isRead])
  @@index([accountId])
  @@index([threadId])
}

// ── Pièces jointes (fichiers sur disque dans storage/attachments, gitignoré) ──
// Le binaire n'est JAMAIS en base : seul le chemin signé est stocké. Accès
// exclusif via /api/emails/attachments/[id] (auth + propriétaire vérifiés).
model EmailAttachment {
  id          String    @id @default(cuid())
  emailId     String
  email       EmailLog  @relation(fields: [emailId], references: [id], onDelete: Cascade)

  filename    String
  contentType String
  /** Taille en octets */
  size        Int
  /** Content-ID MIME pour les images incluses au corps (src="cid:…") */
  contentId   String?
  /** true = image inline (rendue dans le corps), false = pièce jointe classique */
  isInline    Boolean   @default(false)

  /** Chemin relatif dans storage/attachments (nom aléatoire, jamais le nom client) */
  storagePath String

  createdAt   DateTime  @default(now())

  @@index([emailId])
}

model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Endpoint du service push (unique : upsert par endpoint)
  endpoint   String    @unique
  // Clés d'encryption de la subscription : { p256dh, auth } (base64url)
  keys       Json

  // Enrichissement (télémétrie légère, 100 % locale) :
  userAgent  String?   // User-Agent du navigateur abonné
  platform   String?   // "desktop" | "mobile" | "tablet"

  // Subscription active ? false = révoquée (permission retirée, 404/410)
  isActive   Boolean   @default(true)
  lastUsedAt DateTime? // dernier envoi réussi

  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([endpoint])
}

// Préférences de notifications d'un utilisateur (une ligne par utilisateur).
// SQLite : pas d'enum — les types sont des chaînes validées côté Zod.
model NotificationPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Types de notifications
  eventReminder  Boolean @default(true) // rappels d'événements
  taskDeadline   Boolean @default(true) // échéances de tâches
  importantEmail Boolean @default(true) // emails importants flaggés par l'IA
  aiSuggestion   Boolean @default(false) // suggestions IA (priorités…)

  // Timing : avance par défaut du rappel d'événement quand l'événement
  // n'en définit aucun (minutes — défaut 15)
  eventReminderTime Int     @default(15)

  // Heures calmes (aucune notification, sauf imminence < 15 min)
  quietHoursEnabled Boolean @default(false)
  quietHoursStart   String? // "22:00" (heure locale de l'utilisateur)
  quietHoursEnd     String? // "08:00" (peut traverser minuit)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Tombstones de synchronisation (offline-first, multi-appareils) ──────────
// Quand une entité est SUPPRIMÉE côté serveur, la ligne disparait : un pull
// delta ne peut pas la détecter. On enregistre donc une pierre tombale que
// GET /api/sync/changes renvoie aux autres appareils (suppression locale de
// leur cache IndexedDB). Purge auto > 30 j (fenêtre largement suffisante pour
// un appareil hors ligne ; au-delà, la réhydratation complète rattrape).
model SyncTombstone {
  id        String   @id @default(cuid())
  userId    String
  entity    String   // "event" | "task" | "email"
  entityId  String
  deletedAt DateTime @default(now())

  @@index([userId, deletedAt])
  @@index([userId, entity])
}

// Historique des notifications envoyées (centre de notifications in-app).
// SQLite : pas d'enum — type = chaîne validée côté Zod :
// "EVENT_REMINDER" | "TASK_DEADLINE" | "IMPORTANT_EMAIL" | "AI_SUGGESTION" | "SYSTEM" | "CUSTOM"
model Notification {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        String    @default("SYSTEM")
  title       String
  body        String
  icon        String?

  // Données supplémentaires (eventId, taskId, emailId, deep link…) :
  // JSON filtré côté serveur (SQLite ne supporte pas path-filter Prisma).
  data        Json?

  isRead      Boolean   @default(false)
  isSent      Boolean   @default(false) // true si au moins un push est parti
  sentAt      DateTime?

  // Pour les notifications planifiées (futur : file d'attente offline)
  scheduledAt DateTime?

  createdAt   DateTime  @default(now())

  @@index([userId, isRead])
  @@index([userId, type, createdAt])
}
