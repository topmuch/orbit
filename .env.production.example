# ═══════════════════════════════════════════════════════════════════════════
# Orbit — Variables d'environnement de PRODUCTION
#   cp .env.production.example .env.production
#   puis générer TOUS les secrets (commandes indiquées section par section)
#
# ⚠️  .env.production contient vos VRAIS secrets : il n'est JAMAIS commité
#     (règle .gitignore : .env et .env.* sont ignorés). Seul ce fichier
#     .env.production.example — sans aucun secret réel — vit dans le dépôt.
#     Tous les secrets se génèrent avec openssl ou web-push, jamais à la main.
# ═══════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════
# ── Domaine & TLS (Caddy : certificats ACME automatiques) ──────────────────
# ═══════════════════════════════════════════════════════════════════════════
# Nom de domaine principal (l'app y est servie en HTTPS ; www est redirigé
# vers l'apex ; grafana.DOMAIN_NAME et prometheus.DOMAIN_NAME exposent le
# monitoring). Chaque valeur doit exister dans le DNS (enregistrement A).
DOMAIN_NAME="orbit.exemple.fr"

# Adresse e-mail utilisée pour les certificats Let's Encrypt (ACME) :
# c'est là que les notifications d'expiration arrivent (rarement nécessaire,
# Caddy renouvelle tout seul).
ACME_EMAIL="admin@exemple.fr"

# Tag de l'image Docker publiée sur GHCR utilisée par le service web.
# "latest" en pratique courante ; figez un SHA court (ex. "a1b2c3d") pour
# déployer une version précise ou effectuer un rollback manuel.
IMAGE_TAG="latest"

# ═══════════════════════════════════════════════════════════════════════════
# ── Authentification (cookie de session signé HMAC) ────────────────────────
# ═══════════════════════════════════════════════════════════════════════════
# ⚠️ OBLIGATOIRE — signe les sessions et dérive la clé AES-256-GCM qui
# chiffre les mots de passe IMAP/SMTP en base (lib/secret-box.ts).
# Générer :   openssl rand -hex 32
# Ne JAMAIS le changer une fois en production : sessions + secrets chiffrés
# deviendraient invalides.
AUTH_SECRET="generer-avec-openssl-rand-hex-32"

# ═══════════════════════════════════════════════════════════════════════════
# ── Base de données (SQLite + Prisma) ──────────────────────────────────────
# ═══════════════════════════════════════════════════════════════════════════
# VALEUR FIXE en conteneur : la base vit dans le volume orbit_db, monté sur
# /app/db. Ne pas personnaliser.
DATABASE_URL="file:/app/db/custom.db"

# ═══════════════════════════════════════════════════════════════════════════
# ── Application ────────────────────────────────────────────────────────────
# ═══════════════════════════════════════════════════════════════════════════
# URL publique complète (URLs canoniques, CORS, reminders). Doit correspondre
# à DOMAIN_NAME une fois le HTTPS actif.
APP_URL="https://orbit.exemple.fr"

# ═══════════════════════════════════════════════════════════════════════════
# ── Notifications Web Push (VAPID) ─────────────────────────────────────────
# ═══════════════════════════════════════════════════════════════════════════
# Générer la paire :   bunx web-push generate-vapid-keys
#   (ou : npx web-push generate-vapid-keys)
# ⚠️ La clé publique est servie par l'API serveur (/api/subscribe) : il n'y a
#    AUCUNE variable NEXT_PUBLIC_* à définir, aucun build arg.
# ⚠️ Régénérer les clés invalide TOUS les abonnements push existants (les
#    utilisateurs devront se réabonner depuis Réglages).
VAPID_PUBLIC_KEY="<cle-publique-base64url-web-push>"
VAPID_PRIVATE_KEY="<cle-privee-base64url-web-push>"

# Contact de l'émetteur push (convention Web Push, obligatoire).
VAPID_SUBJECT="mailto:notifications@orbit.exemple.fr"

# ═══════════════════════════════════════════════════════════════════════════
# ── Service de rappels (reminder-service :3032) ────────────────────────────
# ═══════════════════════════════════════════════════════════════════════════
# Secret partagé entre reminder-service et POST /api/notify (header
# x-orbit-service-secret). Générer :   openssl rand -hex 24
REMINDER_SERVICE_SECRET="generer-avec-openssl-rand-hex-24"

# Période du cycle de scan (rappels d'événements/tâches + sync IMAP due).
REMINDER_INTERVAL_MS="60000"

# URL interne du service de rappels. Laisser vide → mode « cron externe » :
# le conteneur reminder n'est pas attendu et vous planifiez vous-même
# l'appel (documenté dans docs/push-guide.md §3, ex. */5 * * * *).
REMINDER_SERVICE_URL="http://reminder:3032"

# ═══════════════════════════════════════════════════════════════════════════
# ── Micro-service IA (FastAPI :3031 + Ollama) ──────────────────────────────
# ═══════════════════════════════════════════════════════════════════════════
# URL interne du service IA dans le réseau Docker (pas localhost !).
AI_SERVICE_URL="http://ai-api:3031"

# Timeout des appels IA côté Next.js (le chat en streaming est long).
AI_SERVICE_TIMEOUT_MS="120000"

# Modèle d'inférence utilisé par le micro-service IA.
#   llama3.1:8b (généraliste, ~4,9 Go) · mistral:7b (plus rapide, ~4,1 Go)
OLLAMA_MODEL="llama3.1:8b"

# Modèles pré-téléchargés au premier démarrage du conteneur ollama
# (liste séparée par des espaces ; ex. "llama3.1:8b mistral:7b").
OLLAMA_MODELS="llama3.1:8b"

# Timeout par inférence côté Ollama.
OLLAMA_TIMEOUT_MS="90000"

# Cache mémoire (10 min) des réponses IA identiques — analyse/synthèse.
AI_CACHE_TTL_MS="600000"

# ═══════════════════════════════════════════════════════════════════════════
# ── Métriques Prometheus (/api/metrics) ────────────────────────────────────
# ═══════════════════════════════════════════════════════════════════════════
# OPTIONNEL — si défini, /api/metrics n'est servi qu'avec ce secret
# (header Authorization: Bearer …, configuré dans monitoring/prometheus.yml).
# Laisser vide pour un accès libre sur le réseau interne (non recommandé si
# Prometheus est exposé). Générer :   openssl rand -hex 24
METRICS_SECRET=""

# ═══════════════════════════════════════════════════════════════════════════
# ── Grafana (docker-compose.monitoring.yml) ────────────────────────────────
# ═══════════════════════════════════════════════════════════════════════════
# Compte administrateur du Grafana exposé sur grafana.DOMAIN_NAME.
# Mot de passe : éviter les accents, mettre une vraie phrase de passe.
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD="une-vraie-phrase-de-passe"

# ═══════════════════════════════════════════════════════════════════════════
# ── Sauvegardes (conteneur backup) ─────────────────────────────────────────
# ═══════════════════════════════════════════════════════════════════════════
# Intervalle entre deux sauvegardes automatiques (24 h par défaut).
# Rétention fixe : 7 quotidiennes / 4 hebdomadaires / 6 mensuelles.
BACKUP_INTERVAL_SECONDS="86400"

# ═══════════════════════════════════════════════════════════════════════════
# ── Divers ─────────────────────────────────────────────────────────────────
# ═══════════════════════════════════════════════════════════════════════════
# Fuseau horaire des conteneurs (timestamps des logs, planification
# des sauvegardes et interprétation des heures locales). Identifier :
#   cat /etc/timezone   (ex. Africa/Dakar, Europe/Paris)
TZ="Africa/Dakar"
