# ═══════════════════════════════════════════════════════════════════════════
# Orbit — Variables d'environnement (copier en .env puis adapter)
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════════

# ── Base de données (SQLite en sandbox ; PostgreSQL en production) ─────────
DATABASE_URL="file:./db/custom.db"

# ── Authentification (cookie de session signée HMAC) ────────────────────────
# Générer un secret fort :  openssl rand -hex 32
AUTH_SECRET="changez-moi-avec-openssl-rand-hex-32"

# ── Application ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Orbit"

# ── Micro-service IA (IA locale) ────────────────────────────────────────────
# Next.js délègue TOUTE l'IA à ce service (même contrat en sandbox bun
# mini-services/ai-service et en production FastAPI docker/ai-service).
# Fonctionnalités : analyse d'emails (RDV), suggestion de priorité des tâches,
# assistant conversationnel (streaming), synthèse de contenus longs.
AI_SERVICE_URL="http://localhost:3031"
AI_SERVICE_TIMEOUT_MS="120000"

# ── Ollama — IA 100 % locale (production ; laisser vide en sandbox) ─────────
# En sandbox : laisser OLLAMA_URL vide → le micro-service utilise son
# fallback z-ai-web-dev-sdk. En production locale :
#   OLLAMA_URL="http://localhost:11434"   (ou http://ollama:11434 en compose)
#   ollama pull llama3.1:8b               (téléchargement du modèle, ~4,9 Go)
# Modèles recommandés : llama3.1:8b (généraliste) · mistral:7b (plus rapide)
# nomic-embed-text (embeddings, recherche sémantique future).
OLLAMA_URL=""
OLLAMA_MODEL="llama3.1:8b"
OLLAMA_TIMEOUT_MS="90000"

# Cache mémoire des réponses IA identiques (analyze/suggest/summarize),
# partagé par le micro-service (10 min par défaut).
AI_CACHE_TTL_MS="600000"

# ── Notifications Web Push (VAPID) ──────────────────────────────────────────
# Générer la paire de clés :  bunx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contact@votre-domaine.fr"

# ── Service de rappels (mini-service :3032 → POST /api/notify) ─────────────
# Secret partagé : openssl rand -hex 24
REMINDER_SERVICE_SECRET=""

# ── Phase 3 (futur) : emails réels (IMAP) ──────────────────────────────────
# Les identifiants seront chiffrés en base (chiffrement d'application).
# IMAP_HOST=""
# IMAP_PORT="993"
# IMAP_USER=""
# IMAP_PASSWORD=""

# ── Phase 3 (futur) : notifications email sortantes ────────────────────────
# RESEND_API_KEY=""
# EMAIL_FROM="Orbit <notifications@votre-domaine.fr>"
